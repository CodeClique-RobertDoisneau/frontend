{
  "name": "code-clique",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 80",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:CodeClique": "node dist/CodeClique/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
