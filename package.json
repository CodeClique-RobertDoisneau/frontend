    "@angular/material": "^21.0.1",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@codemirror/language-data": "^6.5.2",
    "katex": "^0.16.25",
    "mermaid": "^11.12.3",
